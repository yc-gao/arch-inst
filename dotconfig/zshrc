export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"
plugins=(
    git sudo
    dotenv colored-man-pages
)
source $ZSH/oh-my-zsh.sh

if [[ -d "$HOME/.local/bin" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

export EDITOR="nvim"
add_local() {
    [[ -d "$1/bin" ]] && export PATH="$1/bin:$PATH"
}

